# Copy to .env.local for local overrides, or set these in Vercel for production.

# Supabase Postgres connection string (use the pooled "transaction" string on Vercel).
# Leave empty locally: the app then runs on an embedded Postgres stored in .data/.
DATABASE_URL=

# Passphrase for the team dashboard at /team. Required in production.
ADMIN_PASSPHRASE=

# Stage switches: on | off. Default is on locally and off in production.
FLAG_DAILY_OPEN=
FLAG_PAYDAY=
FLAG_WEEKLY_WIN=
FLAG_PEOPLE_NUDGE=

# PostHog project key. Events are forwarded from the server only when this is set.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
