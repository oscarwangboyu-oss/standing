# Copy to .env.local for local overrides, or set these in Vercel for production.

# Supabase Postgres connection string (use the pooled "transaction" string on Vercel, port 6543).
# The server always connects to a remote host over TLS. Leave empty locally: the app then runs on
# an embedded Postgres stored in .data/.
DATABASE_URL=

# Passphrase for the team dashboard at /team. Required in production, 20 characters or more.
ADMIN_PASSPHRASE=

# Stage switches: on | off. Default is on locally and off in production.
FLAG_DAILY_OPEN=
FLAG_PAYDAY=
FLAG_WEEKLY_WIN=
FLAG_PEOPLE_NUDGE=

# PostHog project key. Events are forwarded from the server only when this is set.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Mixed into the hash that stands in for a user id in PostHog. Default: the project key.
POSTHOG_SALT=

# local | preview | production. Without it: Vercel's own environment name, otherwise local.
# Set STANDING_ENV=production in the Vercel project.
STANDING_ENV=

# Directory of the embedded local database. Default .data/local.
STANDING_DB_DIR=
